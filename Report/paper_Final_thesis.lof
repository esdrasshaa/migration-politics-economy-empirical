\contentsline {figure}{\numberline {1}{\ignorespaces Monthly number of parliamentary speeches (top: original data; bottom: immigration-related speeches after keyword filtering).}}{8}{figure.1}%
\contentsline {figure}{\numberline {2}{\ignorespaces PCA projection of the expanded immigration dictionaries before cleaning (restrictive = red, welcoming = green).}}{10}{figure.2}%
