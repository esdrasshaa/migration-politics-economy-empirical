\contentsline {figure}{\numberline {1}{\ignorespaces Monthly number of parliamentary speeches (top: original data; bottom: immigration-related speeches after keyword filtering).}}{8}{figure.1}%
\contentsline {figure}{\numberline {2}{\ignorespaces PCA projection of the expanded immigration dictionaries before cleaning (restrictive = red, welcoming = green).}}{10}{figure.2}%
\contentsline {figure}{\numberline {3}{\ignorespaces PCA projection of the refined dictionaries after $y$-coordinate threshold cleaning (restrictive = red, welcoming = green), showing clearer separation between the two stances.}}{11}{figure.3}%
\contentsline {figure}{\numberline {4}{\ignorespaces Average net immigration sentiment by political party (Doc2Vec measure). Negative values indicate that a party's speeches are, on average, closer to the restrictive than to the welcoming reference vector, whether the restrictive vocabulary is used defensively or critically.}}{12}{figure.4}%
\contentsline {figure}{\numberline {5}{\ignorespaces Rolling-window estimation for the Doc2Vec model. The corpus is split into fixed training windows ($m$) and following inference windows ($h$), shifted forward by one period each time. Adapted from \blx@tocontentsinit {0}\textcite {latifi2024fiscal}.}}{13}{figure.5}%
\contentsline {figure}{\numberline {6}{\ignorespaces Monthly trend of overall parliamentary immigration sentiment in Germany. Positive scores show a net-expansive vocabulary; negative scores show more restrictive terminology (whether defensive or critical).}}{15}{figure.6}%
\contentsline {figure}{\numberline {7}{\ignorespaces Monthly trend of government parliamentary immigration sentiment in Germany.}}{15}{figure.7}%
\contentsline {figure}{\numberline {8}{\ignorespaces Monthly trend of opposition parliamentary immigration sentiment in Germany.}}{16}{figure.8}%
\contentsline {figure}{\numberline {9}{\ignorespaces Monthly trend of immigration sentiment for the overall parliament, government, and opposition in Germany.}}{16}{figure.9}%
\contentsline {figure}{\numberline {10}{\ignorespaces Data Comparison: Extended Dataset vs.\ Base Study Data. Five time-series charts (2010--2025) comparing New Data (blue) and Base Data (red) for Migration, Business expectations, Consumer confidence, Industrial Production, and Registered unemployed.}}{23}{figure.10}%
\contentsline {figure}{\numberline {11}{\ignorespaces Impulse responses to a one-standard-deviation government immigration sentiment shock, baseline panel, 2006M1--2019M10 ($n=166$, $p=2$ lags). Bayesian VAR with a diffuse prior and Cholesky identification (sentiment ordered last). Lines show the posterior median; shaded areas show 68\% and 90\% credible bands.}}{26}{figure.11}%
\contentsline {figure}{\numberline {12}{\ignorespaces Impulse responses to a one-standard-deviation opposition immigration sentiment shock, baseline panel, 2006M1--2019M10 ($n=166$, $p=2$ lags). Bayesian VAR with a diffuse prior and Cholesky identification (sentiment ordered last). Lines show the posterior median; shaded areas show 68\% and 90\% credible bands.}}{27}{figure.12}%
\contentsline {figure}{\numberline {13}{\ignorespaces Impulse responses to a one-standard-deviation government immigration sentiment shock, new data panel, 2007M5--2019M10 ($n=150$, $p=2$ lags). Bayesian VAR with a diffuse prior and Cholesky identification (sentiment ordered last). Lines show the posterior median; shaded areas show 68\% and 90\% credible bands.}}{28}{figure.13}%
\contentsline {figure}{\numberline {14}{\ignorespaces Impulse responses to a one-standard-deviation opposition immigration sentiment shock, new data panel, 2007M5--2019M10 ($n=150$, $p=2$ lags). Bayesian VAR with a diffuse prior and Cholesky identification (sentiment ordered last). Lines show the posterior median; shaded areas show 68\% and 90\% credible bands.}}{29}{figure.14}%
\contentsline {figure}{\numberline {15}{\ignorespaces Impulse responses to a one-standard-deviation government immigration sentiment shock, new data panel, 2007M5--2025M6 ($n=218$, $p=3$ lags), including a COVID dummy (2020M3--2021M10). Bayesian VAR with a diffuse prior and Cholesky identification (sentiment ordered last). Lines show the posterior median; shaded areas show 68\% and 90\% credible bands.}}{31}{figure.15}%
\contentsline {figure}{\numberline {16}{\ignorespaces Impulse responses to a one-standard-deviation opposition immigration sentiment shock, new data panel, 2007M5--2025M6 ($n=218$, $p=2$ lags), including a COVID dummy (2020M3--2021M10). Bayesian VAR with a diffuse prior and Cholesky identification (sentiment ordered last). Lines show the posterior median; shaded areas show 68\% and 90\% credible bands.}}{32}{figure.16}%
\contentsline {figure}{\numberline {17}{\ignorespaces Impulse responses to a one-standard-deviation unemployment shock, new data panel, 2007M5--2025M6 ($n=218$, $p=3$ lags), including a COVID dummy (2020M3--2021M10). Bayesian VAR with a diffuse prior and Cholesky identification (variable ordering: arrivals, business expectations, consumer confidence, industrial production, unemployment, government immigration sentiment). Lines show the posterior median; shaded areas show 68\% and 90\% credible bands.}}{34}{figure.17}%
\contentsline {figure}{\numberline {18}{\ignorespaces Impulse responses to a one-standard-deviation unemployment shock, new data panel, 2007M5--2025M6 ($n=218$, $p=2$ lags), including a COVID dummy (2020M3--2021M10). Bayesian VAR with a diffuse prior and Cholesky identification (variable ordering: arrivals, business expectations, consumer confidence, industrial production, unemployment, opposition immigration sentiment). Lines show the posterior median; shaded areas show 68\% and 90\% credible bands.}}{35}{figure.18}%
\contentsline {figure}{\numberline {19}{\ignorespaces Impulse responses to a one-standard-deviation government immigration sentiment shock, new data panel, 2007M5--2014M12 ($n=92$, $p=1$ lag). Bayesian VAR with a diffuse prior and Cholesky identification (sentiment ordered last). Lines show the posterior median; shaded areas show 68\% and 90\% credible bands.}}{40}{figure.19}%
