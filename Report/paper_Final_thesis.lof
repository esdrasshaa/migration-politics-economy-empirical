\contentsline {figure}{\numberline {4}{\ignorespaces Average restrictive immigration sentiment by political party (negative values indicate frequent use of restrictive anti-immigration vocabulary, whether framed defensively or critically).}}{12}{figure.4}%
\contentsline {figure}{\numberline {5}{\ignorespaces Rolling-window estimation for the Doc2Vec model. The corpus is split into fixed training windows ($m$) and following inference windows ($h$), shifted forward by one period each time. Adapted from \blx@tocontentsinit {0}\textcite {latifi2024fiscal}.}}{13}{figure.5}%
\contentsline {figure}{\numberline {6}{\ignorespaces Monthly trend of overall parliamentary immigration sentiment in Germany. Positive scores show a net-expansive vocabulary; negative scores show more restrictive terminology (whether defensive or critical).}}{14}{figure.6}%
\contentsline {figure}{\numberline {7}{\ignorespaces Monthly trend of government parliamentary immigration sentiment in Germany.}}{14}{figure.7}%
\contentsline {figure}{\numberline {8}{\ignorespaces Monthly trend of opposition parliamentary immigration sentiment in Germany.}}{15}{figure.8}%
\contentsline {figure}{\numberline {9}{\ignorespaces Monthly trend of immigration sentiment for the overall parliament, government, and opposition in Germany.}}{15}{figure.9}%
\contentsline {figure}{\numberline {10}{\ignorespaces Data Comparison: Extended Dataset vs.\ Base Study Data. Five time-series charts (2010--2025) comparing New Data (blue) and Base Data (red) for Migration, Business expectations, Consumer confidence, Industrial Production, and Registered unemployed.}}{24}{figure.10}%
\contentsline {figure}{\numberline {11}{\ignorespaces \small \add@extra@listi {sml}\textbf {Impulse response functions to a one-standard-deviation net migration shock.} The plots present the first main result of \blx@tocontentsinit {0}\parencite {maffei2021does}, showing the responses of the endogenous variables to a positive shock to net migration. The impulse responses are obtained from a recursively identified Bayesian VAR model with three lags and Normal--Wishart priors. The shaded areas represent the 68\% credible intervals based on posterior draws.}}{26}{figure.11}%
\contentsline {figure}{\numberline {12}{\ignorespaces \small \add@extra@listi {sml}Macroeconomic and Sentiment Dynamics (2006--2019). The figure shows the responses of the endogenous variables to an increase in immigration sentiment, as reflected in speeches by members of the governing parties (horizons 0--50). Shaded areas denote 68\% credible intervals. All impulse responses are obtained from a recursively identified Bayesian VAR model with one lag and Normal--Wishart priors.}}{27}{figure.12}%
\contentsline {figure}{\numberline {13}{\ignorespaces \small \add@extra@listi {sml}Macroeconomic and Sentiment Dynamics (2006--2019). The figure shows the responses of the endogenous variables to an increase in immigration sentiment, as reflected in speeches by members of the opposition parties (horizons 0--50). Shaded areas denote 68\% credible intervals. All impulse responses are obtained from a recursively identified Bayesian VAR model with one lag and Normal--Wishart priors.}}{28}{figure.13}%
\contentsline {figure}{\numberline {14}{\ignorespaces \small \add@extra@listi {sml}Macroeconomic and Sentiment Dynamics (2006--2019). The figure shows the responses of the endogenous variables to an increase in immigration sentiment, as reflected in speeches of all members of the Bundestag (horizons 0--50). Shaded areas denote 68\% credible intervals. All impulse responses are obtained from a recursively identified Bayesian VAR model with one lag and Normal--Wishart priors.}}{29}{figure.14}%
\contentsline {figure}{\numberline {15}{\ignorespaces \small \add@extra@listi {sml}Macroeconomic and Sentiment Dynamics, New Sample: 2007--2019. Impulse response functions to a one-standard-deviation arrival shock. Shaded areas denote 68\% credible intervals. All impulse responses are obtained from a recursively identified Bayesian VAR model with two lags and a diffuse (flat-Jeffreys) prior.}}{30}{figure.15}%
\contentsline {figure}{\numberline {16}{\ignorespaces \small \add@extra@listi {sml}Macroeconomic and Sentiment Dynamics, New Sample: 2007--2025. Impulse response functions to a one-standard-deviation arrival shock. Shaded areas denote 68\% credible intervals. All impulse responses are obtained from a recursively identified Bayesian VAR model with two lags and a diffuse (flat-Jeffreys) prior, including a COVID-19 exogenous control dummy for observations between March 2020 and October 2021.}}{31}{figure.16}%
\contentsline {figure}{\numberline {17}{\ignorespaces \small \add@extra@listi {sml}Macroeconomic and Sentiment Dynamics, New Sample: 2007--2019. The figure shows the responses of the endogenous variables to an increase in immigration sentiment, as reflected in speeches by members of the governing parties (horizons 0--50). Shaded areas denote 68\% credible intervals. All impulse responses are obtained from a recursively identified Bayesian VAR model with one lag and Normal--Wishart priors.}}{33}{figure.17}%
